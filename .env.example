# ローカル開発では `npx prisma dev` で起動したサーバーの接続文字列を使う
DATABASE_URL="postgres://postgres:postgres@localhost:51213/template1?sslmode=disable"

# `npx @better-auth/cli secret` で生成する
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# メールOTP送信（OneSignal）。OneSignalダッシュボードでApp ID・REST API Keyを発行し、
# Email送信元の設定（ドメイン認証等）も済ませておく必要がある
ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""
