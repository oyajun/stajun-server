# ローカル開発では `npx prisma dev` で起動したサーバーの接続文字列を使う
DATABASE_URL="postgres://postgres:postgres@localhost:51213/template1?sslmode=disable"

# `npx @better-auth/cli secret` で生成する
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_API_KEY=""

# メールOTP送信（Resend）。ResendダッシュボードでAPI Keyを発行する
RESEND_API_KEY=""

# 投稿に対する報告の送信先メールアドレス
REPORT_EMAIL_ADDRESS=""

# APNs プッシュ通知（iOS）
# Apple Developer Portal > Certificates, Identifiers & Profiles > Keys で作成する
APNS_KEY_ID=""         # Key ID（10文字英数字）
APNS_TEAM_ID=""        # Team ID（Apple Developer ポータルの右上に表示）
APNS_BUNDLE_ID="com.oyajun.junjunapp"
# .p8 ファイルの内容をそのまま貼る（改行は \n でエスケープ）
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# "true" にすると本番 APNs エンドポイントを使用（App Store ビルド向け）
APNS_PRODUCTION="false"
