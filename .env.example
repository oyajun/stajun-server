# ローカル開発では `npx prisma dev` で起動したサーバーの接続文字列を使う
DATABASE_URL="postgres://postgres:postgres@localhost:51213/template1?sslmode=disable"

# `npx @better-auth/cli secret` で生成する
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_API_KEY=""

# メールOTP送信（Resend）。ResendダッシュボードでAPI Keyを発行する
RESEND_API_KEY=""

# 投稿に対する報告の送信先メールアドレス
REPORT_EMAIL_ADDRESS=""
